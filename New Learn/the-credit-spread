		colorDark: "#dc2626",
		icon: "🔴",
		description: "Fear dominates. Investors flee corporate bonds for the safety of Treasuries, causing spreads to blow out as risk premiums spike dramatically.",
		sentiment: "Bearish",
		environment: ["Economic slowdown or recession", "Rising default expectations", "Liquidity drying up", "Flight to quality"],
		signals: ["Spreads above historical average", "High-yield bond outflows", "VIX elevated", "Credit default swaps widening"],
	},
