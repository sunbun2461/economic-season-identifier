const scenarios = [
	{
		id: "normal",
		label: "Normal Market",
		treasury: 4.5,
		spread: 3.5,
		color: "#64748b",
		colorLight: "#f1f5f9",
		icon: "📊",
		description: "Typical market conditions with moderate risk appetite. Credit spreads are at historical averages, reflecting balanced growth expectations.",
		sentiment: "Neutral",
