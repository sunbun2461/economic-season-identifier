import { useState } from "react";

const phases = [
  {
    name: "Spring",
    subtitle: "Recovery",
    angle: 0,
    color: "#22c55e",
    bgGradient: "from-emerald-50 to-emerald-100",
    icon: "🌱",
    description: "Early expansion phase with rising confidence, accommodative policy, and improving fundamentals.",
    indicators: ["GDP accelerating", "Falling unemployment", "Low interest rates", "Rising consumer confidence"],
    assets: ["Equities", "High-yield bonds", "Cyclical sectors"],
  },
  {
    name: "Summer",
    subtitle: "Peak",
    angle: 90,
    color: "#f59e0b",
    bgGradient: "from-amber-50 to-amber-100",
    icon: "☀️",
    description: "Mature expansion with peak activity, rising inflation pressures, and full employment.",
    indicators: ["Peak GDP growth", "Full employment", "Rising inflation", "Strong corporate earnings"],
    assets: ["Commodities", "Real estate", "Inflation-protected securities"],
  },
  {
    name: "Autumn",
    subtitle: "Tightening",
    angle: 180,
    color: "#f97316",
    bgGradient: "from-orange-50 to-orange-100",
    icon: "🍂",
    description: "Late-cycle slowdown as policy tightens, growth decelerates, and vulnerabilities emerge.",
    indicators: ["Slowing growth", "Rate hikes", "Yield curve flattening", "Rising volatility"],
    assets: ["Defensive stocks", "Cash", "Short-duration bonds"],
  },
  {
    name: "Winter",
    subtitle: "Contraction",
    angle: 270,
    color: "#3b82f6",
    bgGradient: "from-blue-50 to-blue-100",
    icon: "❄️",
    description: "Recession phase with declining output, rising unemployment, and risk aversion.",
    indicators: ["Falling GDP", "Rising unemployment", "Declining profits", "Flight to safety"],
    assets: ["Government bonds", "Gold", "Defensive equities"],
  },
];

export default function EconomicCycleWheel() {
  const [activePhase, setActivePhase] = useState(null);
  const [hoveredPhase, setHoveredPhase] = useState(null);

  const size = 420;
  const center = size / 2;
  const outerR = 185;
  const innerR = 72;
  const midR = (outerR + innerR) / 2;

  const getArcPath = (startAngle, endAngle, outerRadius, innerRadius) => {
    const toRad = (a) => ((a - 90) * Math.PI) / 180;
    const x1 = center + outerRadius * Math.cos(toRad(startAngle));
    const y1 = center + outerRadius * Math.sin(toRad(startAngle));
    const x2 = center + outerRadius * Math.cos(toRad(endAngle));
    const y2 = center + outerRadius * Math.sin(toRad(endAngle));
    const x3 = center + innerRadius * Math.cos(toRad(endAngle));
    const y3 = center + innerRadius * Math.sin(toRad(endAngle));
    const x4 = center + innerRadius * Math.cos(toRad(startAngle));
    const y4 = center + innerRadius * Math.sin(toRad(startAngle));
    return `M ${x1} ${y1} A ${outerRadius} ${outerRadius} 0 0 1 ${x2} ${y2} L ${x3} ${y3} A ${innerRadius} ${innerRadius} 0 0 0 ${x4} ${y4} Z`;
  };

  const getLabelPos = (startAngle) => {
    const midAngle = startAngle + 45;
    const toRad = (a) => ((a - 90) * Math.PI) / 180;
    return {
      x: center + midR * Math.cos(toRad(midAngle)),
      y: center + midR * Math.sin(toRad(midAngle)),
    };
  };

  const getArrowPath = () => {
    const r = outerR + 14;
    const toRad = (a) => ((a - 90) * Math.PI) / 180;
    const points = [];
    for (let a = 5; a <= 345; a += 2) {
      points.push(`${center + r * Math.cos(toRad(a))},${center + r * Math.sin(toRad(a))}`);
    }
    return `M ${points.join(" L ")}`;
  };

  const arrowEnd = (() => {
    const r = outerR + 14;
    const toRad = (a) => ((a - 90) * Math.PI) / 180;
    const endAngle = 345;
    const ex = center + r * Math.cos(toRad(endAngle));
    const ey = center + r * Math.sin(toRad(endAngle));
    const ta = toRad(endAngle);
    const tx = -Math.sin(ta - Math.PI / 2);
    const ty = Math.cos(ta - Math.PI / 2);
    const px = -ty;
    const py = tx;
    return {
      x: ex, y: ey,
      p1x: ex - tx * 10 + px * 5, p1y: ey - ty * 10 + py * 5,
      p2x: ex - tx * 10 - px * 5, p2y: ey - ty * 10 - py * 5,
    };
  })();

  const active = activePhase !== null ? phases[activePhase] : null;

  const phaseColors = ["#10b981", "#eab308", "#f97316", "#3b82f6"];
  const phaseColorsDark = ["#059669", "#ca8a04", "#ea580c", "#2563eb"];
  const phaseBgs = [
    ["#d1fae5", "#6ee7b7"],
    ["#fef9c3", "#fde047"],
    ["#ffedd5", "#fdba74"],
    ["#dbeafe", "#93c5fd"],
  ];

  return (
    <div
      style={{
        minHeight: "100vh",
        background: "linear-gradient(135deg, #f8fafc 0%, #f1f5f9 50%, #e2e8f0 100%)",
        fontFamily: "'DM Sans', 'Segoe UI', sans-serif",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: "2rem",
      }}
    >
      <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />

      <div style={{ maxWidth: 960, width: "100%", textAlign: "center" }}>
        {/* Header */}
        <div style={{ marginBottom: "2.5rem" }}>
          <p
            style={{
              fontSize: "0.7rem",
              fontWeight: 600,
              letterSpacing: "0.2em",
              textTransform: "uppercase",
              color: "#94a3b8",
              marginBottom: "0.5rem",
            }}
          >
            Macroeconomic Framework
          </p>
          <h1
            style={{
              fontFamily: "'Playfair Display', Georgia, serif",
              fontSize: "2.4rem",
              fontWeight: 700,
              color: "#0f172a",
              margin: 0,
              lineHeight: 1.2,
            }}
          >
            Economic Cycle Wheel
          </h1>
          <p style={{ color: "#64748b", fontSize: "0.95rem", marginTop: "0.6rem", maxWidth: 500, margin: "0.6rem auto 0" }}>
            Four distinct phases of expansion and contraction that shape markets, policy, and investment strategy.
          </p>
        </div>

        <div
          style={{
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: "3rem",
            flexWrap: "wrap",
          }}
        >
          {/* Wheel */}
          <div style={{ position: "relative", flexShrink: 0 }}>
            <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`}>
              <defs>
                {phases.map((_, i) => (
                  <linearGradient key={i} id={`grad-${i}`} x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stopColor={phaseBgs[i][0]} />
                    <stop offset="100%" stopColor={phaseBgs[i][1]} />
                  </linearGradient>
                ))}
                <linearGradient id="arrow-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stopColor="#94a3b8" stopOpacity="0.15" />
                  <stop offset="50%" stopColor="#94a3b8" stopOpacity="0.5" />
                  <stop offset="100%" stopColor="#64748b" stopOpacity="0.7" />
                </linearGradient>
                <filter id="wheel-shadow" x="-10%" y="-10%" width="120%" height="120%">
                  <feDropShadow dx="0" dy="4" stdDeviation="12" floodColor="#0f172a" floodOpacity="0.08" />
                </filter>
                <filter id="inner-shadow" x="-20%" y="-20%" width="140%" height="140%">
                  <feDropShadow dx="0" dy="2" stdDeviation="6" floodColor="#0f172a" floodOpacity="0.1" />
                </filter>
              </defs>

              {/* Circular arrow */}
              <path
                d={getArrowPath()}
                fill="none"
                stroke="url(#arrow-grad)"
                strokeWidth="2"
                strokeDasharray="6 4"
              />
              <polygon
                points={`${arrowEnd.x},${arrowEnd.y} ${arrowEnd.p1x},${arrowEnd.p1y} ${arrowEnd.p2x},${arrowEnd.p2y}`}
                fill="#64748b"
                opacity="0.6"
              />

              {/* Segments */}
              <g filter="url(#wheel-shadow)">
                {phases.map((phase, i) => {
                  const startAngle = i * 90;
                  const endAngle = startAngle + 90;
                  const isHovered = hoveredPhase === i;
                  const isActive = activePhase === i;
                  return (
                    <g key={i}>
                      <path
                        d={getArcPath(startAngle, endAngle, outerR, innerR)}
                        fill={`url(#grad-${i})`}
                        stroke="white"
                        strokeWidth="3"
                        style={{
                          cursor: "pointer",
                          transition: "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
                          filter: isHovered || isActive ? `brightness(1.05)` : "none",
                          transform: isHovered || isActive
                            ? `scale(1.03)`
                            : "scale(1)",
                          transformOrigin: `${center}px ${center}px`,
                        }}
                        onMouseEnter={() => setHoveredPhase(i)}
                        onMouseLeave={() => setHoveredPhase(null)}
                        onClick={() => setActivePhase(activePhase === i ? null : i)}
                      />
                      {/* Accent arc on outer edge */}
                      <path
                        d={getArcPath(startAngle + 4, endAngle - 4, outerR, outerR - 5)}
                        fill={phaseColors[i]}
                        opacity={isHovered || isActive ? 0.9 : 0.5}
                        style={{
                          transition: "opacity 0.3s ease",
                          pointerEvents: "none",
                        }}
                      />
                    </g>
                  );
                })}
              </g>

              {/* Labels on wheel */}
              {phases.map((phase, i) => {
                const pos = getLabelPos(i * 90);
                return (
                  <g
                    key={`label-${i}`}
                    style={{ pointerEvents: "none" }}
                  >
                    <text
                      x={pos.x}
                      y={pos.y - 14}
                      textAnchor="middle"
                      style={{
                        fontSize: "1.15rem",
                        fontWeight: 700,
                        fill: phaseColorsDark[i],
                        fontFamily: "'DM Sans', sans-serif",
                      }}
                    >
                      {phase.icon} {phase.name}
                    </text>
                    <text
                      x={pos.x}
                      y={pos.y + 8}
                      textAnchor="middle"
                      style={{
                        fontSize: "0.72rem",
                        fontWeight: 500,
                        fill: "#64748b",
                        fontFamily: "'DM Sans', sans-serif",
                        textTransform: "uppercase",
                        letterSpacing: "0.1em",
                      }}
                    >
                      {phase.subtitle}
                    </text>
                  </g>
                );
              })}

              {/* Center circle */}
              <g filter="url(#inner-shadow)">
                <circle cx={center} cy={center} r={innerR} fill="white" />
                <circle cx={center} cy={center} r={innerR} fill="none" stroke="#e2e8f0" strokeWidth="1" />
              </g>
              <text
                x={center}
                y={center - 8}
                textAnchor="middle"
                style={{
                  fontSize: "0.68rem",
                  fontWeight: 600,
                  letterSpacing: "0.15em",
                  textTransform: "uppercase",
                  fill: "#94a3b8",
                  fontFamily: "'DM Sans', sans-serif",
                }}
              >
                Economic
              </text>
              <text
                x={center}
                y={center + 12}
                textAnchor="middle"
                style={{
                  fontSize: "0.68rem",
                  fontWeight: 600,
                  letterSpacing: "0.15em",
                  textTransform: "uppercase",
                  fill: "#94a3b8",
                  fontFamily: "'DM Sans', sans-serif",
                }}
              >
                Cycle
              </text>
            </svg>

            {/* Flow label */}
            <p
              style={{
                textAlign: "center",
                fontSize: "0.7rem",
                color: "#94a3b8",
                marginTop: "0.5rem",
                letterSpacing: "0.05em",
              }}
            >
              Spring → Summer → Autumn → Winter →
            </p>
          </div>

          {/* Detail Panel */}
          <div
            style={{
              flex: "1 1 280px",
              maxWidth: 340,
              minHeight: 340,
              display: "flex",
              flexDirection: "column",
              justifyContent: "center",
            }}
          >
            {active ? (
              <div
                key={active.name}
                style={{
                  background: "white",
                  borderRadius: 16,
                  padding: "1.8rem",
                  textAlign: "left",
                  boxShadow: "0 1px 3px rgba(0,0,0,0.04), 0 8px 24px rgba(0,0,0,0.06)",
                  border: `1px solid ${active.color}22`,
                  animation: "fadeSlideIn 0.35s ease",
                }}
              >
                <style>{`
                  @keyframes fadeSlideIn {
                    from { opacity: 0; transform: translateY(12px); }
                    to { opacity: 1; transform: translateY(0); }
                  }
                `}</style>
                <div style={{ display: "flex", alignItems: "center", gap: "0.6rem", marginBottom: "1rem" }}>
                  <span style={{ fontSize: "1.6rem" }}>{active.icon}</span>
                  <div>
                    <h2
                      style={{
                        fontFamily: "'Playfair Display', Georgia, serif",
                        fontSize: "1.5rem",
                        fontWeight: 700,
                        color: active.color,
                        margin: 0,
                        lineHeight: 1.2,
                      }}
                    >
                      {active.name}
                    </h2>
                    <span style={{ fontSize: "0.72rem", textTransform: "uppercase", letterSpacing: "0.12em", color: "#94a3b8", fontWeight: 600 }}>
                      {active.subtitle}
                    </span>
                  </div>
                </div>

                <p style={{ fontSize: "0.85rem", color: "#475569", lineHeight: 1.65, marginBottom: "1.2rem" }}>
                  {active.description}
                </p>

                <div style={{ marginBottom: "1rem" }}>
                  <p style={{ fontSize: "0.65rem", fontWeight: 600, textTransform: "uppercase", letterSpacing: "0.15em", color: "#94a3b8", marginBottom: "0.5rem" }}>
                    Key Indicators
                  </p>
                  <div style={{ display: "flex", flexWrap: "wrap", gap: "0.35rem" }}>
                    {active.indicators.map((ind, j) => (
                      <span
                        key={j}
                        style={{
                          display: "inline-block",
                          padding: "0.3rem 0.65rem",
                          borderRadius: 20,
                          fontSize: "0.72rem",
                          fontWeight: 500,
                          background: `${active.color}10`,
                          color: active.color,
                          border: `1px solid ${active.color}25`,
                        }}
                      >
                        {ind}
                      </span>
                    ))}
                  </div>
                </div>

                <div>
                  <p style={{ fontSize: "0.65rem", fontWeight: 600, textTransform: "uppercase", letterSpacing: "0.15em", color: "#94a3b8", marginBottom: "0.5rem" }}>
                    Favored Assets
                  </p>
                  <div style={{ display: "flex", flexWrap: "wrap", gap: "0.35rem" }}>
                    {active.assets.map((asset, j) => (
                      <span
                        key={j}
                        style={{
                          display: "inline-block",
                          padding: "0.3rem 0.65rem",
                          borderRadius: 20,
                          fontSize: "0.72rem",
                          fontWeight: 500,
                          background: "#f8fafc",
                          color: "#475569",
                          border: "1px solid #e2e8f0",
                        }}
                      >
                        {asset}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <div
                style={{
                  background: "white",
                  borderRadius: 16,
                  padding: "2rem",
                  textAlign: "center",
                  boxShadow: "0 1px 3px rgba(0,0,0,0.04), 0 8px 24px rgba(0,0,0,0.06)",
                  border: "1px solid #e2e8f0",
                }}
              >
                <div style={{ fontSize: "2rem", marginBottom: "0.6rem", opacity: 0.5 }}>📊</div>
                <p style={{ fontSize: "0.9rem", fontWeight: 600, color: "#334155", marginBottom: "0.3rem" }}>
                  Explore each phase
                </p>
                <p style={{ fontSize: "0.8rem", color: "#94a3b8" }}>
                  Click on a segment of the wheel to see key indicators, favored assets, and phase characteristics.
                </p>
              </div>
            )}
          </div>
        </div>

        {/* Bottom phase indicators */}
        <div
          style={{
            display: "flex",
            justifyContent: "center",
            gap: "1.5rem",
            marginTop: "2.5rem",
            flexWrap: "wrap",
          }}
        >
          {phases.map((phase, i) => (
            <button
              key={i}
              onClick={() => setActivePhase(activePhase === i ? null : i)}
              style={{
                display: "flex",
                alignItems: "center",
                gap: "0.45rem",
                padding: "0.5rem 1rem",
                borderRadius: 10,
                border: activePhase === i ? `2px solid ${phase.color}` : "2px solid transparent",
                background: activePhase === i ? `${phase.color}0d` : "white",
                cursor: "pointer",
                transition: "all 0.2s ease",
                boxShadow: "0 1px 3px rgba(0,0,0,0.05)",
              }}
            >
              <span
                style={{
                  width: 8,
                  height: 8,
                  borderRadius: "50%",
                  background: phase.color,
                  display: "inline-block",
                }}
              />
              <span style={{ fontSize: "0.8rem", fontWeight: 600, color: "#334155" }}>
                {phase.name}
              </span>
              <span style={{ fontSize: "0.72rem", color: "#94a3b8" }}>
                {phase.subtitle}
              </span>
            </button>
          ))}
        </div>
      </div>
    </div>
  );
}