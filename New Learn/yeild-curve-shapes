function smoothPath(points, chartX, chartY, chartW, chartH) {
  const pts = points.map((p) => ({
    x: chartX + p.x * chartW,
    y: chartY + chartH - p.y * chartH,
  }));

  if (pts.length < 2) return "";
  let d = `M ${pts[0].x} ${pts[0].y}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const curr = pts[i];
    const next = pts[i + 1];
    const cpx = (curr.x + next.x) / 2;
    d += ` C ${cpx} ${curr.y}, ${cpx} ${next.y}, ${next.x} ${next.y}`;
  }
  return d;
}

function getLabelEnd(points, chartX, chartY, chartW, chartH) {
  const last = points[points.length - 1];
  return {
    x: chartX + last.x * chartW,
    y: chartY + chartH - last.y * chartH,
  };
}

