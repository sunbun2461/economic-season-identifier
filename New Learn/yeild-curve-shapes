          <h1
            style={{
              fontFamily: "'Playfair Display', Georgia, serif",
              fontSize: "2.4rem",
              fontWeight: 700,
              color: "#0f172a",
              margin: 0,
              lineHeight: 1.2,
            }}
          >
            Yield Curve Shapes
          </h1>
          <p
            style={{
              color: "#64748b",
              fontSize: "0.95rem",
              marginTop: "0.6rem",
