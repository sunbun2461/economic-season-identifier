                    key={i}
                    style={{ cursor: "pointer" }}
                    onClick={() => setActiveCurve(activeCurve === i ? null : i)}
                  >
                    {/* Invisible wider hit area */}
                    <path
                      d={path}
                      fill="none"
                      stroke="transparent"
                      strokeWidth="20"
                    />
                    {/* Glow effect for active */}
                    {isActive && (
                      <path
                        d={path}
                        fill="none"
                        stroke={curve.color}
                        strokeWidth="6"
                        strokeOpacity="0.2"
                        strokeLinecap="round"
                        strokeDasharray={curve.dash ? "10 8" : "none"}
                        pathLength="1"
                        strokeDashoffset={curve.dash ? 0 : 1 - animProgress}
                        style={{ filter: "blur(4px)" }}
                      />
                    )}
                    {/* Main line */}
                    <path
                      d={path}
                      fill="none"
                      stroke={curve.color}
                      strokeWidth={isActive ? 3.5 : 2.5}
                      strokeLinecap="round"
                      strokeDasharray={curve.dash ? "10 8" : `${chartW * 2}`}
                      pathLength={curve.dash ? undefined : 1}
                      strokeDashoffset={curve.dash ? 0 : 1 - animProgress}
                      opacity={dimmed ? 0.18 : 1}
                      style={{ transition: "opacity 0.4s ease, stroke-width 0.3s ease" }}
                    />
                    {/* End dot */}
                    <circle
                      cx={labelEnd.x}
                      cy={labelEnd.y}
                      r={isActive ? 5 : 4}
                      fill={curve.color}
                      opacity={dimmed ? 0.18 : animProgress}
                      style={{ transition: "opacity 0.4s ease" }}
