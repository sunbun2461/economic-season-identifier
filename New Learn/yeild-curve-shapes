                <button
                  key={i}
                  onClick={() => setActiveCurve(activeCurve === i ? null : i)}
                  style={{
                    display: "flex",
                    alignItems: "center",
                    gap: "0.4rem",
                    padding: "0.45rem 0.85rem",
                    borderRadius: 8,
                    border: activeCurve === i ? `2px solid ${curve.color}` : "2px solid transparent",
                    background: activeCurve === i ? curve.colorLight : "transparent",
                    cursor: "pointer",
                    transition: "all 0.2s ease",
                  }}
                >
                  <span
                    style={{
                      width: 20,
                      height: 3,
                      borderRadius: 2,
                      background: curve.color,
                      display: "inline-block",
                      borderTop: curve.dash ? `2px dashed ${curve.color}` : "none",
                    }}
                  />
                  <span
                    style={{
                      fontSize: "0.78rem",
                      fontWeight: 600,
                      color: activeCurve === i ? curve.color : "#64748b",
                    }}
                  >
                    {curve.name}
                  </span>
                </button>
              ))}
            </div>
          </div>

          {/* Detail Panel */}
          <div
            style={{
              flex: "1 1 280px",
              maxWidth: 340,
              display: "flex",
              flexDirection: "column",
              justifyContent: "center",
            }}
          >
            {active ? (
              <div
                key={active.name}
                style={{
                  background: "white",
                  borderRadius: 18,
                  padding: "1.8rem",
                  boxShadow: "0 1px 3px rgba(0,0,0,0.04), 0 8px 28px rgba(0,0,0,0.06)",
                  border: `1px solid ${active.color}18`,
                  animation: "fadeSlideIn 0.35s ease",
                }}
              >
                <style>{`
                  @keyframes fadeSlideIn {
                    from { opacity: 0; transform: translateY(12px); }
                    to { opacity: 1; transform: translateY(0); }
                  }
                `}</style>

                <div style={{ display: "flex", alignItems: "center", gap: "0.6rem", marginBottom: "1rem" }}>
                  <span
                    style={{
                      fontSize: "1.5rem",
                      width: 44,
                      height: 44,
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      background: active.colorLight,
                      borderRadius: 12,
                    }}
                  >
                    {active.signalIcon}
                  </span>
                  <div>
                    <h2
                      style={{
                        fontFamily: "'Playfair Display', Georgia, serif",
                        fontSize: "1.5rem",
                        fontWeight: 700,
                        color: active.color,
                        margin: 0,
                        lineHeight: 1.2,
                      }}
                    >
                      {active.name}
                    </h2>
                    <span
                      style={{
                        fontSize: "0.7rem",
                        textTransform: "uppercase",
                        letterSpacing: "0.12em",
                        color: "#94a3b8",
                        fontWeight: 600,
                      }}
                    >
                      {active.signal}
                    </span>
                  </div>
