{
  "name": "macro-tracker",
  "version": "1.0.0",
  "description": "Macro economic cycle tracker with season classification and portfolio guidance",
  "type": "module",
  "scripts": {
    "dev:api": "npx tsx src/server.ts",
    "dev:ui": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:ui\"",
    "build": "cd client && npm run build",
    "start": "npm run build && npx tsx src/server.ts",
    "cli": "npx tsx src/cli.ts"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
