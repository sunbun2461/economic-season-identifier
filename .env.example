FRED_API_KEY=your_fred_api_key_here
PORT=3000

SUPABASE_URL=https://your-project-ref.supabase.co
# Anon key works for now (RLS off). For server-side use, swap for real service_role key:
# Supabase Dashboard → Project Settings → API → service_role (click reveal)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Direct Postgres connection — used by keepalive to auto-create tables
# Get from: Supabase dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
